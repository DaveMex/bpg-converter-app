{
  "name": "bpg-converter-app",
  "version": "1.1.0",
  "description": "A desktop application to convert images to BPG format and vice versa",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaveMex/bpg-converter-app.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron . --no-sandbox",
    "dist": "electron-builder -w -l --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac --universal || electron-builder --mac --x64 --arm64"
  },
  "keywords": [],
  "author": "David Hernández Méndez",
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bpg.converter",
    "productName": "BPG Converter",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "BPG Converter",
      "shortcutName": "BPG Converter"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Graphics",
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "x64ArchFiles": "**/bin/mac/*"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DaveMex",
        "repo": "bpg-converter-app"
      }
    ]
  }
}